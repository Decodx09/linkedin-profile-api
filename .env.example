# ---------------------------------------------------------------------------
# LinkedIn authentication
# ---------------------------------------------------------------------------
# The RECOMMENDED way: paste the value of the `li_at` cookie from a logged-in
# browser session. (DevTools -> Application -> Cookies -> www.linkedin.com)
# This avoids putting your password on the server and survives most checkpoints.
LINKEDIN_LI_AT=

# Optional: the `JSESSIONID` cookie value (with or without the surrounding
# quotes). If omitted, the client fetches a fresh CSRF token automatically.
LINKEDIN_JSESSIONID=

# ---------------------------------------------------------------------------
# Fallback: email + password login (used only if LINKEDIN_LI_AT is empty).
# Note: username/password login is more likely to trigger a security
# checkpoint / 2FA than reusing an existing cookie.
# ---------------------------------------------------------------------------
LINKEDIN_EMAIL=
LINKEDIN_PASSWORD=

# ---------------------------------------------------------------------------
# API server
# ---------------------------------------------------------------------------
# Optional shared secret. If set, callers must send it as `X-API-Key` header
# (or ?api_key=...). Leave empty to disable auth on your endpoint.
API_KEY=

# Simple in-process cache TTL (seconds) for profile responses. 0 disables it.
CACHE_TTL_SECONDS=3600

# Port (most PaaS providers inject this automatically).
PORT=8000
